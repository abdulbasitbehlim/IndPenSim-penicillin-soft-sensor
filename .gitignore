# Optional full raw data remain local; the four reviewed split exports are tracked.
/data/raw/*
!/data/raw/README.md
/data/splits/*
!/data/splits/README.md
!/data/splits/manifest.json
!/data/splits/train_normal_60_batches.csv
!/data/splits/validation_normal_15_batches.csv
!/data/splits/test_normal_15_batches.csv
!/data/splits/test_fault_10_batches.csv

# New generated runs, trained pickle-based models and archives.
/outputs/
*.joblib
*.pkl
*.pickle
*.zip

# Python/Jupyter environments and caches.
.venv*/
venv/
env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Secrets and local editor/system files.
.env
.env.*
*.pem
*.key
.vscode/
.idea/
.DS_Store
Thumbs.db
